# Server
PORT=3003
NODE_ENV=production

# =============================================================================
# PROVIDERS - Chat y Embeddings (100% GRATIS)
# =============================================================================

LLM_PROVIDER=groq
EMBEDDING_PROVIDER=jina

# =============================================================================
# GROQ - LLM para chat (GRATIS)
# =============================================================================
GROQ_API_KEY=tu-api-key-de-groq-aqui
GROQ_CHAT_MODEL=llama-3.2-90b-text-preview

# =============================================================================
# JINA AI - Generacion de embeddings (GRATIS - 8000 req/dia)
# =============================================================================
JINA_API_KEY=tu-api-key-de-jina-aqui
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en

# =============================================================================
# OPENAI (OPCIONAL - solo si usas EMBEDDING_PROVIDER=openai)
# =============================================================================
# OPENAI_API_KEY=tu-api-key-de-openai-aqui
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# VOYAGE AI (OPCIONAL - solo si usas EMBEDDING_PROVIDER=voyageai)
# =============================================================================
# VOYAGEAI_API_KEY=tu-api-key-de-voyageai-aqui
# VOYAGEAI_EMBEDDING_MODEL=voyage-2

# =============================================================================
# OLLAMA (OPCIONAL - solo si usas LLM_PROVIDER=ollama o EMBEDDING_PROVIDER=ollama)
# =============================================================================
# OLLAMA_BASE_URL=http://ollama.railway.internal:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2

# =============================================================================
# ChromaDB - Base de datos vectorial
# =============================================================================
CHROMA_HOST=https://auth-proxy-production-ea3b.up.railway.app
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=plantas_suchiapa
CHROMA_API_KEY=tu-chroma-api-key-aqui
CHROMA_AUTH_PROVIDER=token

# =============================================================================
# API Users - Servicio de usuarios para memoria de conversaciones
# =============================================================================
USERS_SERVICE_URL=http://api-users.railway.internal:3001

# =============================================================================
# Configuracion general
# =============================================================================
CORS_ORIGIN=*
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20