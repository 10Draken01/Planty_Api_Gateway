# Server
PORT=3003
NODE_ENV=production

# =============================================================================
# PROVIDERS - Chat y Embeddings
# =============================================================================
# LLM_PROVIDER: Proveedor para el modelo de chat
#   - groq: Groq API (GRATIS, requiere API key)
#   - ollama: Ollama local (GRATIS, sin API key)
LLM_PROVIDER=groq

# EMBEDDING_PROVIDER: Proveedor para generar embeddings (vectores)
#   - jina: Jina AI (GRATIS - 8000 req/día, requiere API key)
#   - huggingface: Hugging Face Inference API (GRATIS - 1000 req/hora, requiere API key)
#   - ollama: Ollama local (GRATIS ilimitado, sin API key)
#   - openai: OpenAI (PAGO, requiere API key y créditos)
EMBEDDING_PROVIDER=jina

# =============================================================================
# GROQ - LLM para chat (GRATIS)
# =============================================================================
# Obtén tu API key en: https://console.groq.com/keys
GROQ_API_KEY=tu-api-key-de-groq-aqui

# Modelos disponibles:
#   - llama-3.2-90b-text-preview: Más potente, respuestas de alta calidad
#   - llama-3.1-8b-instant: Más rápido, bueno para respuestas simples
GROQ_CHAT_MODEL=llama-3.2-90b-text-preview

# =============================================================================
# JINA AI - Generacion de embeddings (GRATIS - 8000 req/dia)
# =============================================================================
# Obtén tu API key en: https://jina.ai/embeddings/
JINA_API_KEY=tu-api-key-de-jina-aqui

# Modelos disponibles:
#   - jina-embeddings-v2-base-en: 768 dimensiones, inglés
#   - jina-embeddings-v2-small-en: 512 dimensiones, más rápido
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en

# =============================================================================
# HUGGING FACE - Generacion de embeddings (GRATIS - 1000 req/hora)
# =============================================================================
# Obtén tu API key en: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=tu-api-key-de-huggingface-aqui

# Modelos recomendados:
#   - sentence-transformers/all-MiniLM-L6-v2: 384 dims, rápido y eficiente
#   - sentence-transformers/all-mpnet-base-v2: 768 dims, alta calidad
#   - BAAI/bge-small-en-v1.5: 384 dims, buena calidad
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# OPENAI (OPCIONAL - solo si usas EMBEDDING_PROVIDER=openai o LLM_PROVIDER=openai)
# =============================================================================
# Obtén tu API key en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=tu-api-key-de-openai-aqui

# Modelos de embeddings (PAGO):
#   - text-embedding-3-small: 1536 dims, económico ($0.02/1M tokens)
#   - text-embedding-3-large: 3072 dims, alta calidad ($0.13/1M tokens)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# VOYAGE AI (OPCIONAL - solo si usas EMBEDDING_PROVIDER=voyageai)
# =============================================================================
# Obtén tu API key en: https://www.voyageai.com/
# VOYAGEAI_API_KEY=tu-api-key-de-voyageai-aqui

# Modelos disponibles:
#   - voyage-2: 1024 dims, embeddings especializados
#   - voyage-lite-02-instruct: 1024 dims, optimizado para retrieval
# VOYAGEAI_EMBEDDING_MODEL=voyage-2

# =============================================================================
# OLLAMA (OPCIONAL - solo si usas LLM_PROVIDER=ollama o EMBEDDING_PROVIDER=ollama)
# =============================================================================
# URL base de Ollama (local o Railway)
#   - Local: http://localhost:11434
#   - Railway: http://ollama.railway.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Modelo de embeddings (descarga desde ollama.com/library):
#   - nomic-embed-text: 768 dims, recomendado para texto en inglés
#   - mxbai-embed-large: 1024 dims, alta calidad
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Modelo de chat (descarga desde ollama.com/library):
#   - llama3.2: 3B params, rápido y eficiente
#   - llama3.1: 8B params, mejor calidad
# OLLAMA_CHAT_MODEL=llama3.2

# =============================================================================
# ChromaDB - Base de datos vectorial
# =============================================================================
# URL del servidor ChromaDB (con o sin autenticación)
#   - Local sin auth: http://localhost
#   - Railway con auth: https://tu-proxy.up.railway.app
CHROMA_HOST=https://auth-proxy-production-ea3b.up.railway.app

# Puerto de ChromaDB (usualmente 8000)
CHROMA_PORT=8000

# Nombre de la colección donde se almacenan los embeddings
# IMPORTANTE: Cada colección tiene dimensiones fijas definidas por el primer embedding
CHROMA_COLLECTION_NAME=plantas_suchiapa

# API Key para autenticación (si tu ChromaDB tiene auth habilitado)
CHROMA_API_KEY=tu-chroma-api-key-aqui

# Tipo de autenticación: token, basic, etc.
CHROMA_AUTH_PROVIDER=token

# =============================================================================
# API Users - Servicio de usuarios para memoria de conversaciones
# =============================================================================
# URL del servicio api-users (local o Railway)
#   - Local: http://localhost:3001
#   - Railway: http://api-users.railway.internal:3001
USERS_SERVICE_URL=http://api-users.railway.internal:3001

# =============================================================================
# Configuracion general
# =============================================================================
# Orígenes permitidos para CORS (* permite todos)
CORS_ORIGIN=*

# Tamaño de cada chunk de texto al procesar PDFs (en caracteres)
# Valores típicos: 500-2000. Más grande = menos chunks = menos requests de API
CHUNK_SIZE=1000

# Solapamiento entre chunks (en caracteres)
# Ayuda a mantener contexto entre chunks. Típicamente 10-20% del CHUNK_SIZE
CHUNK_OVERLAP=200

# Tamaño máximo de archivo PDF permitido (en MB)
MAX_FILE_SIZE_MB=50

# Ventana de tiempo para rate limiting (en minutos)
RATE_LIMIT_WINDOW_MS=15

# Máximo de requests permitidos en la ventana de tiempo
RATE_LIMIT_MAX_REQUESTS=100

# Máximo de requests de chat permitidos por ventana
CHAT_RATE_LIMIT_MAX=20