# Server
PORT=3003
NODE_ENV=production

# LLM Provider (USA GROQ)
LLM_PROVIDER=groq

# Groq API (REEMPLAZA CON TU API KEY)
GROQ_API_KEY=tu-api-key-de-groq-aqui
GROQ_CHAT_MODEL=llama-3.2-90b-text-preview

# Ollama (SOLO para embeddings)
OLLAMA_BASE_URL=http://ollama.railway.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB (Railway Private Network)
CHROMA_HOST=chromadb.railway.internal
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=plantas_suchiapa

# ChromaDB Authentication (OPCIONAL - Si Railway generó API Key)
# Si tu ChromaDB en Railway tiene Auth Proxy habilitado, descomenta y configura:
CHROMA_API_KEY=tu-chroma-api-key-aqui
CHROMA_AUTH_PROVIDER=token

# CORS
CORS_ORIGIN=*

# PDF Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20