# ============================================================================
# API GATEWAY - CONFIGURACIÓN DE ENTORNO
# ============================================================================

# Puerto en el que corre el API Gateway
PORT=3000

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# ============================================================================
# SEGURIDAD - JWT
# ============================================================================

# ============================================================================
# CORS - Control de acceso de orígenes
# ============================================================================

# Orígenes permitidos (separados por coma)
# En desarrollo: * permite todos los orígenes
# En producción: especificar dominios exactos
CORS_ORIGIN=*

# ============================================================================
# RATE LIMITING - Límites de peticiones
# ============================================================================

# Tiempo de ventana para rate limiting (en minutos)
RATE_LIMIT_WINDOW_MS=15

# Máximo de peticiones generales por ventana
RATE_LIMIT_MAX_REQUESTS=100

# Máximo de intentos de login por ventana
AUTH_RATE_LIMIT_MAX=5

# Máximo de intentos de registro/creación por ventana
CREATE_RATE_LIMIT_MAX=3

# ============================================================================
# MICROSERVICIOS - URLs
# ============================================================================

# URL del microservicio de usuarios
USERS_SERVICE_URL=http://localhost:3001

# URL del microservicio de autenticación
AUTH_SERVICE_URL=http://localhost:3002

# URL del microservicio de chatbot
CHATBOT_SERVICE_URL=http://localhost:3003

# URL del microservicio de orchards
ORCHARD_SERVICE_URL=http://localhost:3004

# URL del microservicio de algoritmo genético (PlantGen)
ALGORITHM_GEN_SERVICE_URL=http://localhost:3005

# URL del microservicio de plantas (Catálogo de plantas)
PLANT_SERVICE_URL=http://localhost:3007

# URL del microservicio de recommender (ML - Sistema de recomendaciones)
RECOMMENDER_SERVICE_URL=http://localhost:3008
