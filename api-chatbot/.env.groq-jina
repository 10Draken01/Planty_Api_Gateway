# Configuracion 100% GRATUITA: Groq (Chat) + Jina (Embeddings)

PORT=3003
NODE_ENV=development

# Providers
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=jina

# Groq para Chat
GROQ_API_KEY=tu-api-key-de-groq-aqui
GROQ_CHAT_MODEL=llama-3.2-90b-text-preview

# Jina para Embeddings
JINA_API_KEY=tu-api-key-de-jina-aqui
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=plantas_suchiapa
CHROMA_API_KEY=
CHROMA_AUTH_PROVIDER=token

# API Users
USERS_SERVICE_URL=http://localhost:3001

# General
CORS_ORIGIN=*
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20
