# Server
PORT=3003
NODE_ENV=production

# =============================================================================
# PROVIDERS - Chat y Embeddings
# =============================================================================

# LLM Provider para CHAT (groq, ollama, openai)
LLM_PROVIDER=groq

# EMBEDDING Provider (openai, jina, ollama, voyageai)
# RECOMENDADO para producción: openai (mejor calidad, ~$0.02/1M tokens)
# RECOMENDADO para desarrollo/free tier: jina (GRATIS - 8000 requests/día)
EMBEDDING_PROVIDER=jina

# =============================================================================
# GROQ - Chat con modelos open source (GRATIS)
# =============================================================================
GROQ_API_KEY=tu-api-key-de-groq-aqui
GROQ_CHAT_MODEL=llama-3.2-90b-text-preview

# =============================================================================
# OPENAI - Embeddings de alta calidad (RECOMENDADO)
# =============================================================================
# Costo: ~$0.02 por 1M tokens (MUY BARATO)
# Regístrate en: https://platform.openai.com/
OPENAI_API_KEY=tu-api-key-de-openai-aqui
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Alternativa más cara pero mejor: text-embedding-3-large

# =============================================================================
# JINA AI - Embeddings GRATUITOS (RECOMENDADO para desarrollo)
# =============================================================================
# GRATIS: 8000 requests por día
# Perfecta combinación con Groq para chat
# Regístrate en: https://jina.ai/
# Modelos disponibles:
#   - jina-embeddings-v2-base-en: 768 dimensiones (recomendado)
#   - jina-embeddings-v2-small-en: 512 dimensiones (más rápido)
JINA_API_KEY=tu-api-key-de-jina-aqui
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en

# =============================================================================
# VOYAGE AI - Embeddings especializados (ALTERNATIVA)
# =============================================================================
# Especializado en embeddings, similar calidad a OpenAI
# Regístrate en: https://www.voyageai.com/
# VOYAGEAI_API_KEY=tu-api-key-de-voyageai-aqui
# VOYAGEAI_EMBEDDING_MODEL=voyage-2

# =============================================================================
# OLLAMA - Solo si tienes Ollama desplegado (NO RECOMENDADO en Railway)
# =============================================================================
# IMPORTANTE: Ollama requiere infraestructura adicional y es costoso en Railway
# Solo usa esto si tienes Ollama corriendo en otro servidor
OLLAMA_BASE_URL=http://ollama.railway.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB (Railway Private Network)
# IMPORTANTE: Si usas ChromaDB Auth Proxy, usa la URL del proxy
# Si usas ChromaDB directo, usa chromadb.railway.internal
CHROMA_HOST=https://auth-proxy-production-ea3b.up.railway.app
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=plantas_suchiapa

# ChromaDB Authentication (REQUERIDO si usas Auth Proxy)
# Obtén la API Key de las variables de entorno de tu ChromaDB en Railway
CHROMA_API_KEY=tu-chroma-api-key-aqui
CHROMA_AUTH_PROVIDER=token

# API Users Service (Railway Internal o URL pública)
# IMPORTANTE: Necesario para memoria de conversaciones
USERS_SERVICE_URL=http://api-users.railway.internal:3001

# CORS
CORS_ORIGIN=*

# PDF Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20